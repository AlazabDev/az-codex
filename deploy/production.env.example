# az-codex production environment
# Copy to /etc/az-codex/az-codex.env, owner root:frappe, mode 0640.
# Never commit the real file.

NODE_ENV=production

# WebUI authentication
CODEX_WEBUI_PASSWORD_HASH=
CODEX_WEBUI_OWNER_PASSWORD_HASH=
CODEX_WEBUI_SESSION_SECRET=

# Public edge is Nginx; WebUI remains loopback-only.
HOST=127.0.0.1
PORT=4173
CODEX_WEBUI_BASE_PATH=
CODEX_WEBUI_REQUIRE_OWNER=true
CODEX_WEBUI_REQUIRE_ORIGIN_HEADER=true
CODEX_WEBUI_TRUST_PROXY_HEADERS=true
CODEX_WEBUI_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CODEX_WEBUI_COOKIE_SAMESITE=strict
CODEX_WEBUI_COOKIE_SECURE=true

# Codex runtime
CODEX_HOME=/home/frappe/.codex
CODEX_WEBUI_CODEX_BIN=/usr/bin/codex
CODEX_WEBUI_PROJECT_ROOT=/opt/az-codex
CODEX_WEBUI_ALLOWED_ROOTS=/home/frappe/frappe-bench
CODEX_WEBUI_DATA_DIR=/home/frappe/.codex/codex-webui
CODEX_WEBUI_DEFAULT_PROFILE_ID=azcodex
CODEX_WEBUI_PROFILES_JSON='[{"id":"codex","label":"Codex OpenAI","codexHome":"/home/frappe/.codex","dataDir":"/home/frappe/.codex/codex-webui/profiles/codex"},{"id":"azcodex","label":"Az Codex Foundry","codexHome":"/home/frappe/.azcodex","dataDir":"/home/frappe/.codex/codex-webui/profiles/azcodex"}]'
CODEX_WEBUI_GIT_DISCOVERY_DEPTH=3

# Session/runtime behavior
CODEX_WEBUI_APP_SERVER_TIMEOUT_SECONDS=1800
CODEX_WEBUI_APP_SERVER_HANDOFF=true
CODEX_WEBUI_PER_SESSION_APP_SERVERS=false
CODEX_WEBUI_FORCE_YOLO=true
CODEX_WEBUI_DEFAULT_LANGUAGE_BRIDGE=false
CODEX_WEBUI_DEFAULT_LANGUAGE_BRIDGE_OUTPUT_LANGUAGE=auto

# Attachments
CODEX_WEBUI_MAX_UPLOAD_MB=100
CODEX_WEBUI_MAX_ATTACHMENT_STORAGE_MB=10240

# Host shutdown is intentionally disabled from the UI.
CODEX_WEBUI_ENABLE_SYSTEM_SHUTDOWN=false
CODEX_WEBUI_SHUTDOWN_DELAY_SECONDS=30
CODEX_WEBUI_SHUTDOWN_COMMAND=/usr/bin/true


# Microsoft Foundry runtime. Required for the default azcodex production profile.
# Keep credentials only in the real env file; never commit them.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_VERSION=
AZCODEX_HOME=/home/frappe/.azcodex
