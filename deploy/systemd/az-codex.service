[Unit]
Description=Az Codex WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frappe
Group=frappe
WorkingDirectory=/home/frappe/az-codex

# The Rust gateway loads /home/frappe/az-codex/.env itself from the working directory.
# Keep Foundry config materialization as a pre-start validation step.
ExecStartPre=/usr/bin/node --env-file=/home/frappe/az-codex/.env /home/frappe/az-codex/bin/azcodex.mjs setup
ExecStart=/home/frappe/az-codex/backend/target/release/backend

Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
