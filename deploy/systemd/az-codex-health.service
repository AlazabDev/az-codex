[Unit]
Description=Az Codex WebUI health check
After=az-codex.service

[Service]
Type=oneshot
User=frappe
Group=frappe
WorkingDirectory=/opt/az-codex
EnvironmentFile=/etc/az-codex/az-codex.env
ExecStart=/bin/sh -c '/usr/bin/curl --fail --silent --max-time 5 http://127.0.0.1:4173/healthz >/dev/null || /usr/bin/node /opt/az-codex/bin/codex-webui.mjs restart'
