{
  "name": "az-codex",
  "version": "0.2.0",
  "private": false,
  "description": "Production-grade Codex workspace with SvelteKit WebUI, Rust gateway, Frappe automation and registry-driven Alazab integrations.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "AlazabDev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlazabDev/az-codex.git"
  },
  "bugs": {
    "url": "https://github.com/AlazabDev/az-codex/issues"
  },
  "homepage": "https://github.com/AlazabDev/az-codex#readme",
  "keywords": [
    "codex",
    "codex-cli",
    "webui",
    "ai-agent",
    "agentic-development",
    "frappe",
    "erpnext",
    "mcp",
    "openapi",
    "sveltekit",
    "rust",
    "websocket",
    "developer-tools",
    "automation",
    "alazab"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "azcodex": "./bin/azcodex.mjs",
    "codex-webui": "./bin/codex-webui.mjs"
  },
  "files": [
    "backend",
    "bin",
    "build",
    "deploy",
    "dist",
    "docs",
    "mcp",
    "messages",
    "scripts",
    "src",
    "static",
    "templates",
    ".env.example",
    "project.inlang",
    "README.md",
    "svelte.config.js",
    "vite.config.ts"
  ],
  "scripts": {
    "start": "node ./bin/codex-webui.mjs",
    "cli": "node ./bin/codex-webui.mjs",
    "azcodex": "node ./bin/azcodex.mjs",
    "dev": "pnpm paraglide:compile && vite dev",
    "dev:web": "pnpm dev",
    "dev:gateway": "setpriv --no-new-privs --inh-caps=-all --ambient-caps=-all cargo run --manifest-path backend/Cargo.toml",
    "build": "pnpm paraglide:compile && svelte-kit sync && node ./scripts/build-app.mjs",
    "build:web": "pnpm build",
    "build:gateway": "cargo build --manifest-path backend/Cargo.toml",
    "build:cross": "node ./scripts/build-cross.mjs",
    "build:e2e-fake": "cargo build --manifest-path backend/Cargo.toml --bin fake_codex_app_server",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable preferredLanguage baseLocale --is-server 'import.meta.env.SSR' --emit-ts-declarations",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:gateway": "cargo check --manifest-path backend/Cargo.toml",
    "verify": "pnpm verify:mcp && pnpm verify:static-build && pnpm verify:api-parity && pnpm verify:codex-compat && pnpm verify:security-regressions && pnpm verify:tunnel-safety",
    "verify:mcp": "node ./scripts/mcp-registry.mjs doctor",
    "verify:api-parity": "node ./scripts/verify-api-parity.mjs",
    "verify:codex-compat": "node ./scripts/verify-codex-compat.mjs",
    "verify:codex-protocol": "pnpm verify:codex-compat",
    "verify:static-build": "node ./scripts/verify-static-build.mjs",
    "verify:security-regressions": "node ./scripts/verify-security-regressions.mjs",
    "verify:low-memory-smoke": "node ./scripts/verify-low-memory-smoke.mjs",
    "verify:tunnel-safety": "node ./scripts/verify-tunnel-safety.mjs",
    "test": "pnpm test:unit",
    "test:unit": "node --test ./scripts/azcodex.test.mjs ./scripts/frappe-bench.test.mjs ./scripts/mcp-registry.test.mjs ./scripts/ws-client-backpressure.test.mjs ./frontend-tests/chart-renderer.test.mjs",
    "test:ws-client-backpressure": "node --test ./scripts/ws-client-backpressure.test.mjs",
    "test:azcodex": "node --test ./scripts/azcodex.test.mjs",
    "test:frappe-bench": "node --test ./scripts/frappe-bench.test.mjs",
    "test:mcp": "node --test ./scripts/mcp-registry.test.mjs",
    "test:charts": "node --test ./frontend-tests/chart-renderer.test.mjs",
    "test:e2e": "pnpm build && pnpm verify:static-build && pnpm verify:api-parity && pnpm build:e2e-fake && playwright test",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "gateway:dev": "pnpm dev:gateway",
    "gateway:check": "pnpm check:gateway",
    "gateway:build": "pnpm build:gateway",
    "mcp:list": "node ./scripts/mcp-registry.mjs list",
    "mcp:doctor": "node ./scripts/mcp-registry.mjs doctor",
    "ws:debug": "node ./scripts/ws-debug-client.mjs",
    "hash-password": "node ./scripts/hash-password.mjs",
    "frappe:install": "node ./scripts/install-frappe-profile.mjs",
    "frappe:mcp": "node ./mcp/frappe-bench.mjs",
    "frappe:test": "node --test ./scripts/frappe-bench.test.mjs",
    "ci": "pnpm check && pnpm check:gateway && pnpm test:unit && pnpm build && pnpm verify",
    "pack:check": "npm pack --dry-run",
    "release:check": "pnpm ci && pnpm pack:check",
    "prepublishOnly": "pnpm release:check"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.16.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.48.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^17.0.0",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.9",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
